    return;
  }

  if(state.checkoutOpen){
    head.textContent = 'Finalizar pedido';
    const subtotal = cartSubtotal();
    wrap.innerHTML = `
      <button class="back-link" onclick="backToCart()">${iconSvg('accessory','style="width:13px;height:13px;stroke:var(--muted)"')} Volver al carrito</button>
      <div class="order-summary-mini">
        ${state.cart.map(c=>{
          const p = PRODUCTS.find(x=>x.id===c.id);
          return `<div class="row"><span>${c.qty}× ${p.name}</span><span>${fmt(p.price*c.qty)}</span></div>`;
        }).join('')}
        <div class="row total"><span>Subtotal</span><span>${fmt(subtotal)}</span></div>
      </div>
      <form id="checkoutForm" class="checkout-form" onsubmit="submitOrder(event)">
        <div class="cfield">
          <label for="coNombre">Nombre y apellido</label>
          <input id="coNombre" type="text" placeholder="Ej. María Torres" required>
        </div>
        <div class="cfield">
          <label for="coTelefono">Teléfono / WhatsApp</label>
          <input id="coTelefono" type="tel" inputmode="numeric" placeholder="Ej. 987654321" pattern="[0-9]{7,9}" maxlength="9" required>
        </div>
        <div class="cfield">
          <label for="coDireccion">Dirección de entrega</label>
          <textarea id="coDireccion" placeholder="Calle, número, distrito, referencia" required></textarea>
        </div>
        <div class="cfield">
          <label>Método de pago</label>
          <div class="pay-options" id="payOptions">
            <label class="pay-option checked"><input type="radio" name="metodoPago" value="mp" checked onchange="markPayOption(this)">💳 Tarjeta / Mercado Pago (pago en línea)</label>
            <label class="pay-option"><input type="radio" name="metodoPago" value="Yape / Plin" onchange="markPayOption(this)">Yape / Plin</label>
            <label class="pay-option"><input type="radio" name="metodoPago" value="Transferencia bancaria" onchange="markPayOption(this)">Transferencia bancaria</label>
            <label class="pay-option"><input type="radio" name="metodoPago" value="Pago contraentrega" onchange="markPayOption(this)">Pago contraentrega</label>
          </div>
        </div>
        <button type="submit" class="btn-gold" id="checkoutSubmitBtn" style="width:100%;">Pagar con Mercado Pago</button>
      </form>
    `;
    footer.innerHTML = '';
    return;
  }

  // default: cart items view
  head.textContent = 'Tu carrito';
  const subtotal = cartSubtotal();
  wrap.innerHTML = state.cart.map(c=>{
    const p = PRODUCTS.find(x=>x.id===c.id);
