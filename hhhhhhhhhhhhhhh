<script>
/* ======================================================================
   DATA
   ====================================================================== */
const CATEGORIES = [
  {key:'cuerda', label:'Instrumentos de Cuerda', icon:'string',
    subs:[{key:'guitarras',label:'Guitarras'},{key:'violines',label:'Violines'},{key:'ukeleles',label:'Ukeleles'},{key:'charangos',label:'Charangos'}]},
  {key:'teclados', label:'Teclados', icon:'keyboard',
    subs:[{key:'teclados',label:'Teclados'}]},
  {key:'percusion', label:'Percusión', icon:'drum',
    subs:[{key:'tambores',label:'Tambores'},{key:'bombos',label:'Bombos'},{key:'tarolas',label:'Tarolas'},{key:'cajones',label:'Cajones'},{key:'metalofono',label:'Metalófono'}]},
  {key:'viento', label:'Viento', icon:'wind',
    subs:[{key:'flautas',label:'Flautas'},{key:'melodicas',label:'Melódicas'},{key:'quenas',label:'Quenas'},{key:'zamponas',label:'Zampoñas'}]},
  {key:'audio', label:'Micrófono y Audio', icon:'mic',
    subs:[{key:'microfonos',label:'Micrófonos'},{key:'interfaces',label:'Interfaces'}]},
  {key:'colegio', label:'Para Colegio', icon:'school',
    subs:[{key:'bombito',label:'Bombito'},{key:'flautaColegio',label:'Flauta'},{key:'melodicaColegio',label:'Melódica'},{key:'lira',label:'Lira'},{key:'xilofono',label:'Xilófono'}]},
  {key:'accesorios', label:'Accesorios', icon:'accessory',
    subs:[{key:'accGuitarra',label:'Guitarra'},{key:'accViento',label:'Viento'},{key:'accPercusion',label:'Percusión'},{key:'parantes',label:'Parantes'}]},
];

/* ======================================================================
   PRODUCTOS — se cargan automáticamente desde tu Google Sheet.
   Ya no viven escritos aquí: para cambiar precios, ofertas, stock,
   fotos o video, edita directamente la hoja de cálculo. Este archivo
   solo pide los datos al abrir la tienda.
   ====================================================================== */

/* ⚠️ Pega aquí la URL de tu Web App de Google Apps Script (ver productos-backend.gs) */
const PRODUCTS_API_URL = 'https://script.google.com/macros/s/AKfycbzhLV2VKfsztEc0UoxheyfSkCXfLI-s648zvfBv68esyE7kzU3tt3L-K40lSQ4lRX1o/exec';

/* ⚠️ Pega aquí el link de tu Google Sheet, para el atajo del panel de admin */
const PRODUCTS_SHEET_URL = 'https://docs.google.com/spreadsheets/d/1v9gBb7H1f8eATqXK8LjcAlyh7isfFtLp6OME4ThD_gI/edit?usp=sharing';

let PRODUCTS = [];
let PRICE_MAX = 3000; // valor por defecto mientras cargan los productos reales

/* Ícono decorativo por defecto según la categoría (no depende de la hoja) */
const ICON_BY_CAT = {
  cuerda:'string', teclados:'keyboard', percusion:'drum', viento:'wind',
  audio:'mic', colegio:'school', accesorios:'accessory'
};
function iconFor(p){ return ICON_BY_CAT[p.cat] || 'accessory'; }

async function fetchProducts(){
  if(!PRODUCTS_API_URL || PRODUCTS_API_URL.startsWith('PEGA_AQUI')){
    document.getElementById('app').innerHTML = `
      <div class="empty-state" style="padding-top:120px;">
        ${iconSvg('accessory')}
        <p>Falta configurar PRODUCTS_API_URL en el código.<br>Revisa las instrucciones para conectar tu Google Sheet.</p>
      </div>`;
    return;
  }
  try{
    const res = await fetch(PRODUCTS_API_URL);
    const data = await res.json();
    if(data.error) throw new Error(data.error);
    PRODUCTS = data.products || [];
    PRICE_MAX = PRODUCTS.length ? Math.max(...PRODUCTS.map(p=>p.price)) : 3000;
    state.priceMax = PRICE_MAX;
    render();
    checkPaymentReturnStatus();
    checkAdminUrlTrigger();
  }catch(err){
    document.getElementById('app').innerHTML = `
      <div class="empty-state" style="padding-top:120px;">
        ${iconSvg('accessory')}
        <p>No se pudieron cargar los productos.<br>Revisa tu conexión o intenta de nuevo en un momento.</p>
        <button class="btn-outline" style="margin-top:14px;" onclick="fetchProducts()">Reintentar</button>
      </div>`;
  }
}

/* Convierte una URL de YouTube en un link embebible; si no es YouTube, la deja igual */
function toEmbedUrl(url){
  const m = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/))([\w-]{11})/);
  return m ? `https://www.youtube.com/embed/${m[1]}` : null;
}

/* ======================================================================
   ICONS (family-level line art, consistent brand style)
   ====================================================================== */
const ICONS = {
  string:'<path d="M15 4l5 5M15 4c-3 0-9 6-9 9a4 4 0 1 0 4 4c3 0 9-6 9-9M6 18l-3 3"/><circle cx="9" cy="15" r="0.6" fill="currentColor"/>',
  keyboard:'<rect x="3" y="7" width="18" height="10" rx="1.5"/><path d="M7 7v6M11 7v6M15 7v6M19 7v6"/>',
  drum:'<ellipse cx="12" cy="7" rx="8" ry="3"/><path d="M4 7v9a8 3 0 0 0 16 0V7"/><path d="M4 12a8 3 0 0 0 16 0"/>',
  wind:'<path d="M3 12h16a2.5 2.5 0 1 0-2.5-2.5"/><circle cx="8" cy="12" r=".6" fill="currentColor"/><circle cx="11" cy="12" r=".6" fill="currentColor"/><circle cx="14" cy="12" r=".6" fill="currentColor"/>',
  mic:'<rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0M12 17v5M9 22h6"/>',
  school:'<path d="M12 3l9 4.5-9 4.5-9-4.5L12 3z"/><path d="M6 10.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-5.5"/>',
  accessory:'<path d="M12 3c4 0 6 4 6 7.5S14 21 12 21s-6-4.5-6-10.5S8 3 12 3z"/><circle cx="12" cy="9" r="1.4" fill="currentColor"/>'
};
function iconSvg(type, extra){
  return '<svg viewBox="0 0 24 24" fill="none" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" '+(extra||'')+'>'+(ICONS[type]||ICONS.accessory)+'</svg>';
}
const chevron='<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>';

/* ======================================================================
   STATE (in-memory only — no localStorage/sessionStorage per platform rules)
   ====================================================================== */
const state = {
  view:'home',
  activeCat:null,
  activeSubs:new Set(),
  priceMin:0,
  priceMax:PRICE_MAX,
  sort:'relevancia',
  search:'',
  cart:[], // {id, qty}
  checkoutOpen:false,
  orderPlaced:false
};

const fmt = n => 'S/ ' + n.toLocaleString('es-PE',{minimumFractionDigits:0});

/* ======================================================================
   NAV BUILD (catbar, drawer, footer)
   ====================================================================== */
function buildNavLists(){
  document.getElementById('catbarInner').innerHTML = CATEGORIES.map(c=>
    `<button class="${state.view==='shop'&&state.activeCat===c.key?'active':''}" onclick="goShop('${c.key}')">${c.label}</button>`
  ).join('') + `<button class="${state.view==='shop'&&!state.activeCat?'active':''}" onclick="goShop(null)">Todos</button>`;

  document.getElementById('drawerCats').innerHTML = CATEGORIES.map(c=>
    `<a class="cat-link" href="#" onclick="toggleMenu(false);goShop('${c.key}');return false;">${c.label}</a>` +
    c.subs.map(s=>`<a class="sub-link" href="#" onclick="toggleMenu(false);goShop('${c.key}','${s.key}');return false;">${s.label}</a>`).join('')
  ).join('');

  document.getElementById('footerCats').innerHTML = CATEGORIES.map(c=>
    `<button class="link" onclick="goShop('${c.key}')">${c.label}</button>`
  ).join('');
}

/* ======================================================================
   ROUTING
   ====================================================================== */
function goHome(){
  state.view='home';
  render();
  window.scrollTo({top:0,behavior:'smooth'});
}
function goShop(catKey, subKey){
  state.view='shop';
  state.activeCat = catKey || null;
  state.activeSubs = new Set(subKey?[subKey]:[]);
  state.priceMin=0; state.priceMax=PRICE_MAX; state.search='';
  render();
  window.scrollTo({top:0,behavior:'smooth'});
}
function doSearch(mobile){
  const val = document.getElementById(mobile?'searchInputMobile':'searchInput').value.trim();
  state.view='shop'; state.activeCat=null; state.activeSubs=new Set(); state.search=val;
  render();
  window.scrollTo({top:0,behavior:'smooth'});
}
function toggleMobileSearch(){
  const el=document.getElementById('mobileSearchBar');
  el.style.display = el.style.display==='none' ? 'block' : 'none';
}

/* ======================================================================
   RENDER: HOME
   ====================================================================== */
function renderHome(){
  return `
  <section class="hero">
    <div class="kicker">Instrumentos Musicales en Perú</div>
    <h1 class="h-serif">Tu música empieza aquí</h1>
    <p>Guitarras, teclados, percusión, viento, audio y todo lo necesario para el colegio. Calidad para principiantes y profesionales, con envíos a todo el país.</p>
    <div class="hero-actions">
