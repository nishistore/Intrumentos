/* ======================================================================
   PRODUCT DETAIL (quick view) — galería de fotos + video
   ====================================================================== */
let pdState = { productId: null, activeIndex: 0, qty: 1 };

function openProductDetail(id){
  const p = PRODUCTS.find(x=>x.id===id);
  if(!p) return;
  pdState = { productId: id, activeIndex: 0, qty: 1 };
  renderProductDetail();
  document.getElementById('modalOverlay').classList.add('show');
}

function renderProductDetail(){
  const p = PRODUCTS.find(x=>x.id===pdState.productId);
  if(!p) return;
  const catObj = CATEGORIES.find(c=>c.key===p.cat);
  const subLabel = catObj ? (catObj.subs.find(s=>s.key===p.sub)||{}).label : '';
  const images = p.images || [];
  const video = p.video;
  const stock = p.stock || 0;
  const outOfStock = stock <= 0;
  const lowStock = stock > 0 && stock <= 3;

  const slides = [...images.map(url=>({type:'image', url})), ...(video ? [{type:'video', url:video}] : [])];
  if(pdState.activeIndex >= slides.length) pdState.activeIndex = 0;
  const active = slides[pdState.activeIndex];

  let mainHtml;
  if(!active){
    mainHtml = `<div class="pd-icon">${iconSvg(iconFor(p))}</div>`;
  }else if(active.type === 'image'){
    mainHtml = `<img src="${active.url}" alt="${p.name}" decoding="async">`;
  }else{
    const embed = toEmbedUrl(active.url);
    mainHtml = embed
      ? `<iframe src="${embed}" allow="autoplay; encrypted-media" allowfullscreen></iframe>`
      : `<video src="${active.url}" controls></video>`;
  }

  const thumbsHtml = slides.length > 1 ? `
    <div class="pd-thumbs">
      ${slides.map((s,i)=>`
        <div class="pd-thumb ${i===pdState.activeIndex?'active':''} ${s.type==='video'?'video-thumb':''}" onclick="setActiveSlide(${i})">
          ${s.type==='image' ? `<img src="${s.url}">` : '▶'}
        </div>`).join('')}
    </div>` : '';

  const stockHtml = outOfStock
    ? `<div class="pd-stock-out">Agotado</div>`
    : lowStock
      ? `<div class="pd-stock-low">¡Solo quedan ${stock} unidades!</div>`
      : `<div class="pd-stock-ok">✓ Disponible</div>`;

  document.getElementById('modalBody').innerHTML = `
    <div class="pd-gallery">${mainHtml}</div>
    ${thumbsHtml}
    <div class="pd-cat">${subLabel}</div>
    <div class="pd-name">${p.name}</div>
    <div class="pd-price-row">
      <span class="pd-price">${fmt(p.price)}</span>
      ${p.old?`<span class="pd-oldprice">${fmt(p.old)}</span>`:''}
    </div>
    ${stockHtml}
    ${outOfStock ? '' : `
      <div class="pd-qty-row">
        <div class="qty-ctrl">
          <button onclick="pdChangeQty(-1)">−</button>
          <span id="pdQtyLabel">${pdState.qty}</span>
          <button onclick="pdChangeQty(1)">+</button>
        </div>
      </div>
      <button class="btn-gold" style="width:100%;" onclick="addFromDetail(${p.id})">Agregar al carrito</button>
    `}
  `;
}

function setActiveSlide(i){ pdState.activeIndex = i; renderProductDetail(); }

function stockOf(id){ const p = PRODUCTS.find(x=>x.id===id); return p ? (p.stock||0) : 0; }

function pdChangeQty(delta){
  const stock = stockOf(pdState.productId);
  const next = pdState.qty + delta;
  if(next < 1) return;
  if(next > stock){ showToast(`Solo hay ${stock} unidad(es) disponibles`); return; }
  pdState.qty = next;
  document.getElementById('pdQtyLabel').textContent = pdState.qty;
}

function addFromDetail(id){
  for(let i=0;i<pdState.qty;i++) addToCart(id);
  closeModal();
}

function addToCart(id, btnEl){
  const available = stockOf(id);
  if(available <= 0){ showToast('Este producto está agotado'); return; }
  const existing = state.cart.find(c=>c.id===id);
  const currentQty = existing ? existing.qty : 0;
  if(currentQty >= available){ showToast(`Solo hay ${available} unidad(es) disponibles`); return; }
  if(existing) existing.qty++; else state.cart.push({id, qty:1});
  updateCartCount();
  showToast('Producto agregado al carrito');
  if(btnEl){
    btnEl.classList.add('added');
    const original = btnEl.innerHTML;
    btnEl.innerHTML = '✓ Agregado';
    setTimeout(()=>{btnEl.classList.remove('added'); btnEl.innerHTML = original;}, 1200);
  }
}
function changeQty(id, delta){
  const item = state.cart.find(c=>c.id===id);
  if(!item) return;
  const available = stockOf(id);
  if(delta > 0 && item.qty >= available){ showToast(`Solo hay ${available} unidad(es) disponibles`); return; }
  item.qty += delta;
  if(item.qty<=0) state.cart = state.cart.filter(c=>c.id!==id);
  updateCartCount();
  renderCartDrawer();
}
function removeFromCart(id){
  state.cart = state.cart.filter(c=>c.id!==id);
  updateCartCount();
  renderCartDrawer();
}
function updateCartCount(){
  const total = state.cart.reduce((s,c)=>s+c.qty,0);
  const el = document.getElementById('cartCount');
  el.textContent = total;
  el.style.display = total>0 ? 'flex':'none';
}
function cartSubtotal(){
  return state.cart.reduce((s,c)=>{
    const p = PRODUCTS.find(x=>x.id===c.id);
    return s + p.price*c.qty;
  },0);
}

function renderCartDrawer(){
  const wrap = document.getElementById('cartItemsWrap');
  const footer = document.getElementById('cartFooter');
  const head = document.querySelector('#cartDrawer .drawer-head b');

  if(state.orderPlaced){
    head.textContent = 'Pedido enviado';
    wrap.innerHTML = `
      <div class="order-success">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--ok)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="width:52px;height:52px;margin:0 auto 16px;"><circle cx="12" cy="12" r="9.3"/><path d="M8 12.5l2.7 2.7L16.5 9"/></svg>
        <h4>¡Gracias por tu pedido!</h4>
        <p>Te contactaremos por WhatsApp para confirmar el pago y coordinar la entrega.</p>
