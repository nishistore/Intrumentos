function markPayOption(input){
  document.querySelectorAll('.pay-option').forEach(el=>el.classList.remove('checked'));
  input.closest('.pay-option').classList.add('checked');
  const btn = document.getElementById('checkoutSubmitBtn');
  if(btn) btn.textContent = input.value === 'mp' ? 'Pagar con Mercado Pago' : 'Confirmar pedido por WhatsApp';
}

function goToCheckout(){
  state.checkoutOpen = true;
  renderCartDrawer();
}
function backToCart(){
  state.checkoutOpen = false;
  renderCartDrawer();
}

/* ⚠️ Reemplaza con tu número real de WhatsApp Business (código de país + número, sin +, espacios ni guiones) */
const STORE_WHATSAPP = '51917100948';

/* ⚠️ Pega aquí la URL de tu Web App de Google Apps Script (ver mercadopago-backend.gs) */
const MP_API_URL = 'https://script.google.com/macros/s/AKfycbyIMPy7sF3BI9cHcJiAF2ls-rGbnb5dMzCadSeGW7_iV_0rH1cK0knhz6riAsNP-rLq/exec';

async function submitOrder(e){
  e.preventDefault();
  const nombre = document.getElementById('coNombre').value.trim();
  const telefono = document.getElementById('coTelefono').value.trim();
  const direccion = document.getElementById('coDireccion').value.trim();
  const metodoPago = document.querySelector('input[name="metodoPago"]:checked').value;
  if(!nombre || !telefono || !direccion){ return; }

  if(metodoPago === 'mp'){
    await payWithMercadoPago({nombre, telefono, direccion});
    return;
  }

  const subtotal = cartSubtotal();
  const lineas = state.cart.map(c=>{
    const p = PRODUCTS.find(x=>x.id===c.id);
    return `• ${c.qty}x ${p.name} — ${fmt(p.price*c.qty)}`;
  }).join('\n');

  const mensaje =
`🎵 Nuevo pedido - Instrumentos Chipao

${lineas}

Subtotal: ${fmt(subtotal)}

Cliente: ${nombre}
Teléfono: ${telefono}
Dirección: ${direccion}
Método de pago: ${metodoPago}`;

  const url = `https://wa.me/${STORE_WHATSAPP}?text=${encodeURIComponent(mensaje)}`;
  window.open(url, '_blank', 'noopener');

  state.orderPlaced = true;
  state.checkoutOpen = false;
  state.cart = [];
  updateCartCount();
  renderCartDrawer();
}

async function payWithMercadoPago(comprador){
  if(!MP_API_URL || MP_API_URL.startsWith('PEGA_AQUI')){
    showToast('Falta configurar MP_API_URL en el código. Revisa las instrucciones.');
    return;
  }
  const btn = document.getElementById('checkoutSubmitBtn');
  const original = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Redirigiendo a Mercado Pago...';

  const items = state.cart.map(c=>{
    const p = PRODUCTS.find(x=>x.id===c.id);
    return { title: p.name, quantity: c.qty, unit_price: p.price };
  });

  try{
    const res = await fetch(MP_API_URL, {
      method: 'POST',
      headers: { 'Content-Type': 'text/plain;charset=utf-8' }, // evita preflight CORS con Apps Script
      body: JSON.stringify({ items, comprador })
    });
    const data = await res.json();
    if(data.init_point){
      window.location.href = data.init_point;
    }else{
      throw new Error(data.error || 'Sin init_point');
    }
  }catch(err){
    showToast('No se pudo conectar con Mercado Pago. Intenta con otro método.');
    btn.disabled = false;
    btn.textContent = original;
  }
}

/* Al volver de Mercado Pago, la URL trae ?status=approved|pending|failure */
function checkPaymentReturnStatus(){
  const params = new URLSearchParams(window.location.search);
  const status = params.get('status');
  if(!status) return;
  if(status === 'approved'){
    state.cart = []; updateCartCount();
    showToast('✅ Pago aprobado. ¡Gracias por tu compra!');
  }else if(status === 'pending'){
    showToast('⏳ Tu pago está pendiente de confirmación.');
  }else if(status === 'failure'){
    showToast('❌ El pago no se completó. Puedes intentar de nuevo.');
  }
  // limpia el parámetro de la URL sin recargar la página
  window.history.replaceState({}, '', window.location.pathname);
}

function finishOrder(){
  state.orderPlaced = false;
  toggleCart(false);
}

function toggleCart(show){
  document.getElementById('cartDrawer').classList.toggle('show', show);
  document.getElementById('cartOverlay').classList.toggle('show', show);
  if(show){ state.checkoutOpen=false; state.orderPlaced=false; renderCartDrawer(); }
}
function toggleMenu(show){
  document.getElementById('menuDrawer').classList.toggle('show', show);
  document.getElementById('menuOverlay').classList.toggle('show', show);
}
document.getElementById('menuBtn').addEventListener('click', ()=>toggleMenu(true));

