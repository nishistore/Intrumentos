    <div class="cart-item">
      <div class="thumb">${iconSvg(iconFor(p))}</div>
      <div class="info">
        <div class="name">${p.name}</div>
        <div class="price">${fmt(p.price)}</div>
        <div class="qty-ctrl">
          <button onclick="changeQty(${p.id},-1)">−</button>
          <span>${c.qty}</span>
          <button onclick="changeQty(${p.id},1)">+</button>
        </div>
        <button class="remove-btn" onclick="removeFromCart(${p.id})">Eliminar</button>
      </div>
    </div>`;
  }).join('');
  footer.innerHTML = `
    <div class="cart-subtotal"><span>Subtotal</span><span>${fmt(subtotal)}</span></div>
    <button class="btn-gold" style="width:100%;margin-bottom:10px;" onclick="goToCheckout()">Ir a pagar</button>
    <button class="btn-outline" style="width:100%;" onclick="toggleCart(false)">Seguir comprando</button>
  `;
