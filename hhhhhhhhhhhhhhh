                ${c.label}
              </label>
              ${chevron}
            </div>
            <div class="subs">
              ${c.subs.map(s=>`
                <label class="chk">
                  <input type="checkbox" ${state.activeSubs.has(s.key)?'checked':''} onchange="toggleSub('${c.key}','${s.key}', this.checked)">
