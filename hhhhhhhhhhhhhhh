<style>
:root{
  --navy-deep:#f7efe0;
  --navy-mid:#f0e0c4;
  --navy-card:#fffaf2;
  --navy-line:#ddc39c;
  --navy-soft:#f4e6cc;
  --gold:#c2701f;
  --gold-light:#f0b46a;
  --gold-dim:#8f4d12;
  --brown-heading:#5c3410;
  --cream:#4a3018;
  --ink:#6b5540;
  --muted:#96805f;
  --ok:#5c8142;
  --err:#b5583f;
  --chrome-bg:#1f140c;
  --chrome-bg2:#2b1c10;
  --chrome-line:#4a3520;
  --chrome-text:#f3e6d3;
  --chrome-muted:#c2a880;
  --radius-lg:22px;
  --radius-md:14px;
  --radius-sm:10px;
  --header-h:64px;
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;overflow-x:hidden;width:100%;}
body{
  font-family:'Poppins',sans-serif;
  background:var(--navy-deep);
  color:var(--cream);
  min-height:100vh;
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
  width:100%;
}
img,svg{display:block;}
a{color:inherit;text-decoration:none;}
button{font-family:inherit;cursor:pointer;}
ul{list-style:none;}
.h-serif{font-family:'Playfair Display',serif;}

/* ---------------- header ---------------- */
header.site{
  position:sticky;top:0;z-index:40;
  background:rgba(31,20,12,.96);
  backdrop-filter:blur(10px);
  border-bottom:1px solid var(--chrome-line);
}
.header-top{
  height:var(--header-h);
  display:flex;align-items:center;gap:14px;
  padding:0 18px;
  max-width:1280px;margin:0 auto;
}
.logo{
  font-family:'Playfair Display',serif;
  font-weight:800;font-size:22px;
  background:linear-gradient(180deg,var(--gold-light),var(--gold));
  -webkit-background-clip:text;background-clip:text;color:transparent;
  white-space:nowrap;
  flex-shrink:0;
}
.logo span{display:block;font-family:'Poppins',sans-serif;font-size:9px;letter-spacing:.22em;color:var(--chrome-muted);font-weight:600;-webkit-text-fill-color:var(--chrome-muted);}
.icon-btn{
  width:40px;height:40px;border-radius:50%;
  border:1px solid var(--chrome-line);background:var(--chrome-bg2);
  display:flex;align-items:center;justify-content:center;
  color:var(--chrome-text);flex-shrink:0;position:relative;
  transition:border-color .2s ease, transform .15s ease;
}
.icon-btn:hover{border-color:var(--gold);transform:translateY(-1px);}
.icon-btn svg{width:19px;height:19px;stroke:currentColor;}
.search-wrap{flex:1;position:relative;max-width:640px;}
.search-wrap input{
  width:100%;padding:11px 44px 11px 16px;
  background:var(--chrome-bg2);border:1px solid var(--chrome-line);
  border-radius:50px;color:var(--chrome-text);font-size:14px;font-family:inherit;
  transition:border-color .2s ease, box-shadow .2s ease;
}
.search-wrap input::placeholder{color:var(--chrome-muted);}
.search-wrap input:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(194,112,31,.25);}
.search-wrap button{
  position:absolute;right:5px;top:50%;transform:translateY(-50%);
  width:32px;height:32px;border-radius:50%;border:none;
  background:linear-gradient(135deg,var(--gold-light),var(--gold));
  display:flex;align-items:center;justify-content:center;
}
.search-wrap button svg{width:16px;height:16px;stroke:#1a1305;}
.cart-count{
  position:absolute;top:-3px;right:-3px;
  background:var(--gold);color:#1a1305;
  font-size:10px;font-weight:800;
  width:17px;height:17px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
}
.hide-mobile{display:none;}
.hide-desktop{display:flex;}

nav.catbar{
  border-top:1px solid var(--chrome-line);
  overflow-x:auto;
  scrollbar-width:none;
}
nav.catbar::-webkit-scrollbar{display:none;}
.catbar-inner{
  display:flex;gap:6px;padding:10px 18px;
  max-width:1280px;margin:0 auto;
  white-space:nowrap;
}
.catbar-inner button{
  background:transparent;border:1px solid transparent;
  color:var(--chrome-muted);font-size:13px;font-weight:500;
  padding:7px 14px;border-radius:50px;
  transition:.2s ease;
}
.catbar-inner button:hover{border-color:var(--chrome-line);color:var(--gold-light);}
.catbar-inner button.active{background:var(--gold);color:#1a1305;font-weight:700;}

/* ---------------- mobile drawer (menu) ---------------- */
.overlay{
  position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:60;
  opacity:0;pointer-events:none;transition:opacity .25s ease;
}
.overlay.show{opacity:1;pointer-events:auto;}
.drawer{
  position:fixed;top:0;bottom:0;left:0;width:86%;max-width:340px;
  background:var(--chrome-bg);border-right:1px solid var(--chrome-line);
  z-index:61;transform:translateX(-105%);transition:transform .3s ease;
  overflow-y:auto;padding:20px 0 40px;
  color:var(--chrome-text);
}
.drawer.show{transform:translateX(0);}
.drawer-head{display:flex;justify-content:space-between;align-items:center;padding:0 20px 16px;border-bottom:1px solid var(--chrome-line);margin-bottom:8px;}
.drawer a.cat-link{display:block;padding:13px 20px;font-weight:600;font-size:14.5px;border-bottom:1px solid rgba(255,255,255,.06);color:var(--chrome-text);}
.drawer a.cat-link:hover{background:rgba(194,112,31,.12);color:var(--gold-light);}
.drawer .sub-link{display:block;padding:9px 20px 9px 34px;font-size:13px;color:var(--chrome-muted);border-bottom:1px solid rgba(255,255,255,.04);}
.drawer .sub-link:hover{color:var(--gold-light);}

/* cart drawer */
.cart-drawer{
  position:fixed;top:0;bottom:0;right:0;width:92%;max-width:400px;
  background:var(--chrome-bg);border-left:1px solid var(--chrome-line);
  z-index:61;transform:translateX(105%);transition:transform .3s ease;
  display:flex;flex-direction:column;
  color:var(--chrome-text);
}
.cart-drawer.show{transform:translateX(0);}
.cart-drawer .drawer-head{border-bottom:1px solid var(--chrome-line);}
.cart-items{flex:1;overflow-y:auto;padding:10px 16px;}
.cart-item{display:flex;gap:12px;padding:14px 0;border-bottom:1px solid rgba(255,255,255,.05);}
.cart-item .thumb{width:56px;height:56px;border-radius:12px;background:var(--navy-card);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.cart-item .thumb svg{width:28px;height:28px;stroke:var(--gold);}
.cart-item .info{flex:1;min-width:0;}
.cart-item .name{font-size:13.5px;font-weight:600;margin-bottom:4px;}
.cart-item .price{font-size:13px;color:var(--brown-heading);font-weight:700;}
.qty-ctrl{display:flex;align-items:center;gap:8px;margin-top:6px;}
.qty-ctrl button{width:24px;height:24px;border-radius:6px;border:1px solid var(--navy-line);background:var(--navy-card);color:var(--cream);font-size:14px;}
.qty-ctrl span{font-size:13px;min-width:16px;text-align:center;}
.remove-btn{color:var(--err);font-size:11.5px;font-weight:600;margin-top:6px;background:none;border:none;}
.cart-footer{padding:18px 20px 22px;border-top:1px solid var(--navy-line);}
.cart-subtotal{display:flex;justify-content:space-between;font-size:15px;font-weight:700;margin-bottom:14px;}
.cart-empty{padding:60px 20px;text-align:center;color:var(--muted);font-size:13.5px;}

/* checkout form (inside cart drawer) */
.back-link{display:inline-flex;align-items:center;gap:6px;color:var(--muted);font-size:12.5px;background:none;border:none;padding:14px 16px 0;}
.back-link:hover{color:var(--brown-heading);}
.back-link svg{width:13px;height:13px;stroke:currentColor;}
.order-summary-mini{background:var(--navy-card);border:1px solid var(--navy-line);border-radius:12px;padding:13px 15px;font-size:12.5px;color:var(--ink);margin:14px 16px 0;}
.order-summary-mini .row{display:flex;justify-content:space-between;padding:3px 0;}
.order-summary-mini .row.total{border-top:1px solid var(--navy-line);margin-top:6px;padding-top:8px;font-weight:700;color:var(--brown-heading);font-size:13.5px;}
.checkout-form{display:flex;flex-direction:column;gap:14px;padding:16px;}
.checkout-form .cfield > label{display:block;font-size:11.5px;font-weight:600;letter-spacing:.03em;color:var(--brown-heading);text-transform:uppercase;margin-bottom:6px;}
.checkout-form input, .checkout-form select, .checkout-form textarea{
  width:100%;padding:12px 14px;background:var(--navy-card);border:1px solid var(--navy-line);
  border-radius:10px;color:var(--cream);font-family:inherit;font-size:13.5px;
}
.checkout-form input::placeholder, .checkout-form textarea::placeholder{color:var(--muted);}
.checkout-form input:focus, .checkout-form select:focus, .checkout-form textarea:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(185,130,76,.15);}
.checkout-form textarea{resize:vertical;min-height:64px;font-family:inherit;}
.pay-options{display:flex;flex-direction:column;gap:8px;}
.pay-option{display:flex;align-items:center;gap:10px;padding:11px 13px;border:1px solid var(--navy-line);border-radius:10px;font-size:13px;cursor:pointer;transition:.2s ease;}
.pay-option:hover{border-color:var(--gold-dim);}
.pay-option input{width:auto;accent-color:var(--gold);}
.pay-option.checked{border-color:var(--gold);background:rgba(185,130,76,.06);}
.order-success{text-align:center;padding:50px 24px;}
.order-success svg{width:52px;height:52px;stroke:var(--ok);margin:0 auto 16px;}
.order-success h4{font-family:'Playfair Display',serif;color:var(--brown-heading);font-size:19px;margin-bottom:8px;}
.order-success p{color:var(--ink);font-size:13.3px;line-height:1.6;}

/* ---- overrides: everything above lives inside the DARK drawers ---- */
.drawer .cart-item .price, .cart-drawer .cart-item .price,
.drawer .cfield > label, .cart-drawer .cfield > label,
.drawer .order-success h4, .cart-drawer .order-success h4{color:var(--gold-light) !important;}
.drawer .back-link, .cart-drawer .back-link{color:var(--chrome-muted);}
.drawer .back-link:hover, .cart-drawer .back-link:hover{color:var(--gold-light);}
.drawer .order-success p, .cart-drawer .order-success p{color:var(--chrome-muted);}
.drawer .remove-btn, .cart-drawer .remove-btn{color:#e0977c;}
.drawer .pay-option, .cart-drawer .pay-option{border-color:var(--chrome-line);}
.drawer .pay-option.checked, .cart-drawer .pay-option.checked{border-color:var(--gold);background:rgba(194,112,31,.12);}
.drawer .cart-empty, .cart-drawer .cart-empty{color:var(--chrome-muted);}
.drawer .cart-empty svg, .cart-drawer .cart-empty svg{stroke:var(--gold-dim);}

/* ---------------- buttons ---------------- */
.btn-gold{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  background:linear-gradient(135deg,var(--gold-light),var(--gold) 60%,var(--gold-dim));
  color:#1a1305;font-weight:700;font-size:14.5px;
  padding:13px 22px;border:none;border-radius:50px;
  transition:transform .2s ease, box-shadow .2s ease;
}
.btn-gold:hover{transform:translateY(-2px);box-shadow:0 14px 26px -10px rgba(185,130,76,.55);}
.btn-outline{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  background:transparent;border:1.5px solid var(--gold);
  color:var(--brown-heading);font-weight:600;font-size:14px;
  padding:12px 20px;border-radius:50px;
  transition:.2s ease;
}
.btn-outline:hover{background:var(--gold);color:#1a1305;}

/* ---------------- hero ---------------- */
.hero{
  position:relative;overflow:hidden;
  background:
    radial-gradient(ellipse 700px 420px at 20% -10%, rgba(185,130,76,.18), transparent 60%),
    radial-gradient(ellipse 600px 500px at 90% 100%, rgba(185,130,76,.10), transparent 60%),
    linear-gradient(160deg,var(--navy-deep),var(--navy-mid));
  padding:56px 20px 60px;
  text-align:center;
}
.hero .kicker{font-size:12px;letter-spacing:.3em;color:var(--brown-heading);font-weight:600;text-transform:uppercase;opacity:.85;}
.hero h1{font-size:38px;line-height:1.15;margin:14px 0 14px;
  background:linear-gradient(180deg,var(--brown-heading),var(--gold-dim));
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.hero p{color:var(--ink);max-width:46ch;margin:0 auto 26px;font-size:15px;line-height:1.6;}
.hero-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;}
.hero-badges{display:flex;gap:22px;justify-content:center;margin-top:34px;flex-wrap:wrap;color:var(--muted);font-size:12px;}
.hero-badges div{display:flex;align-items:center;gap:7px;}
.hero-badges svg{width:16px;height:16px;stroke:var(--gold);}

/* ---------------- section wrap ---------------- */
.wrap{max-width:1280px;margin:0 auto;padding:0 20px;}
.section-title{display:flex;align-items:baseline;justify-content:space-between;margin:52px 0 22px;}
.section-title h2{font-family:'Playfair Display',serif;font-size:26px;color:var(--brown-heading);}
.section-title span{color:var(--muted);font-size:13px;}

/* category grid on home */
.cat-grid{
  display:grid;grid-template-columns:repeat(2,1fr);gap:14px;
  padding-bottom:50px;
}
.cat-card{
  position:relative;border-radius:var(--radius-md);
  background:linear-gradient(150deg,var(--navy-card),var(--navy-soft));
  border:1px solid var(--navy-line);
  padding:22px 16px;overflow:hidden;
  transition:transform .2s ease, border-color .2s ease;
  min-height:130px;display:flex;flex-direction:column;justify-content:flex-end;gap:8px;
}
.cat-card:hover{transform:translateY(-3px);border-color:var(--gold);}
.cat-card svg{width:34px;height:34px;stroke:var(--gold);position:absolute;top:16px;left:16px;opacity:.9;}
.cat-card b{font-size:14.5px;position:relative;z-index:2;}
.cat-card small{color:var(--muted);font-size:11.5px;position:relative;z-index:2;}
.cat-card .glow{position:absolute;width:130px;height:130px;border-radius:50%;background:radial-gradient(circle,rgba(185,130,76,.18),transparent 70%);top:-40px;right:-40px;}

/* ---------------- shop layout ---------------- */
.shop-layout{display:flex;gap:26px;align-items:flex-start;padding-bottom:60px;}
.filters{
  width:250px;flex-shrink:0;position:sticky;top:calc(var(--header-h) + 60px);
  background:var(--navy-card);border:1px solid var(--navy-line);
  border-radius:var(--radius-md);padding:20px;
}
.filters h3{font-size:13px;text-transform:uppercase;letter-spacing:.08em;color:var(--brown-heading);margin-bottom:14px;}
.filter-group{margin-bottom:24px;}
.filter-group + .filter-group{border-top:1px solid var(--navy-line);padding-top:18px;}
.cat-accordion .cat-head{
  display:flex;justify-content:space-between;align-items:center;
  padding:9px 0;font-size:13.5px;font-weight:600;color:var(--cream);
}
.cat-accordion .cat-head svg{width:14px;height:14px;stroke:var(--muted);transition:transform .2s ease;}
.cat-accordion.open .cat-head svg{transform:rotate(180deg);}
.cat-accordion .subs{display:none;padding-left:6px;}
.cat-accordion.open .subs{display:block;}
.chk{display:flex;align-items:center;gap:9px;padding:6px 0;font-size:12.8px;color:var(--ink);cursor:pointer;}
.chk input{accent-color:var(--gold);width:14px;height:14px;}
.chk:hover{color:var(--brown-heading);}
.price-inputs{display:flex;align-items:center;gap:8px;margin-bottom:12px;}
.price-inputs input{
  width:100%;padding:9px 10px;background:var(--navy-mid);border:1px solid var(--navy-line);
  border-radius:8px;color:var(--cream);font-size:12.5px;font-family:inherit;
}
.price-inputs input:focus{outline:none;border-color:var(--gold);}
input[type=range]{width:100%;accent-color:var(--gold);}
.clear-filters{width:100%;text-align:center;font-size:12.5px;color:var(--muted);background:none;border:1px dashed var(--navy-line);padding:9px;border-radius:8px;margin-top:6px;}
.clear-filters:hover{color:var(--brown-heading);border-color:var(--gold);}

.shop-main{flex:1;min-width:0;}
.shop-toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;gap:10px;flex-wrap:wrap;}
.shop-toolbar .count{font-size:13px;color:var(--muted);}
.shop-toolbar select{
  background:var(--navy-card);border:1px solid var(--navy-line);color:var(--cream);
  padding:9px 12px;border-radius:8px;font-size:12.5px;font-family:inherit;
}
.filters-btn{display:none;align-items:center;gap:6px;background:var(--navy-card);border:1px solid var(--navy-line);color:var(--cream);padding:9px 14px;border-radius:8px;font-size:12.5px;}
.filters-btn svg{width:14px;height:14px;stroke:var(--gold);}

.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
.product-card{
  background:var(--navy-card);border:1px solid var(--navy-line);
  border-radius:var(--radius-md);overflow:hidden;
  display:flex;flex-direction:column;
  transition:transform .2s ease, border-color .2s ease;
}
.product-card:hover{transform:translateY(-4px);border-color:var(--gold);}
.product-photo{
  position:relative;aspect-ratio:1/1;
  background:radial-gradient(ellipse at 35% 30%, rgba(185,130,76,.16), transparent 65%), var(--navy-mid);
  display:flex;align-items:center;justify-content:center;
}
.product-photo svg{width:52%;height:52%;stroke:var(--gold);opacity:.92;}
.product-photo-img{width:100%;height:100%;object-fit:cover;}
.video-badge{
  position:absolute;bottom:9px;right:9px;background:rgba(58,38,20,.72);
  color:var(--gold-light);font-size:10px;font-weight:700;padding:4px 9px;
  border-radius:50px;border:1px solid var(--gold-dim);
}

/* product detail (quick view) */
.pd-gallery{position:relative;aspect-ratio:1/1;border-radius:16px;overflow:hidden;background:var(--navy-mid);margin-bottom:12px;}
.pd-gallery img, .pd-gallery video, .pd-gallery iframe{width:100%;height:100%;object-fit:cover;border:none;display:block;}
.pd-gallery .pd-icon{width:100%;height:100%;display:flex;align-items:center;justify-content:center;}
.pd-gallery .pd-icon svg{width:44%;height:44%;stroke:var(--gold);}
.pd-thumbs{display:flex;gap:8px;margin-bottom:18px;}
.pd-thumb{
  width:56px;height:56px;border-radius:10px;overflow:hidden;border:2px solid var(--navy-line);
  flex-shrink:0;cursor:pointer;position:relative;background:var(--navy-card);
  display:flex;align-items:center;justify-content:center;
}
.pd-thumb img{width:100%;height:100%;object-fit:cover;}
.pd-thumb.active{border-color:var(--gold);}
.pd-thumb.video-thumb{color:var(--brown-heading);font-size:18px;}
.pd-cat{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin-bottom:4px;}
.pd-name{font-family:'Playfair Display',serif;font-size:21px;color:var(--brown-heading);margin-bottom:10px;padding-right:26px;}
.pd-price-row{display:flex;align-items:baseline;gap:10px;margin-bottom:6px;}
.pd-price{font-size:22px;font-weight:800;color:var(--brown-heading);}
.pd-oldprice{font-size:14px;color:var(--muted);text-decoration:line-through;}
.pd-stock-ok{font-size:12.5px;color:var(--ok);font-weight:600;margin-bottom:16px;}
.pd-stock-low{font-size:12.5px;color:#a05a1a;font-weight:600;margin-bottom:16px;}
.pd-stock-out{font-size:12.5px;color:var(--err);font-weight:600;margin-bottom:16px;}
.pd-qty-row{display:flex;align-items:center;gap:14px;margin-bottom:16px;}
.pd-qty-row .qty-ctrl{background:var(--navy-card);border:1px solid var(--navy-line);border-radius:50px;padding:6px 10px;}
.pd-qty-row .qty-ctrl button{width:26px;height:26px;border-radius:50%;}
.pd-qty-row .qty-ctrl span{min-width:20px;}
.badge{
  position:absolute;top:10px;left:10px;
  background:var(--gold);color:#1a1305;font-size:10px;font-weight:800;
  padding:4px 9px;border-radius:50px;letter-spacing:.02em;
}
.badge.discount{background:var(--err);color:#fff;}
.badge.out{background:#6b5f4f;color:#f5ede0;}
.stock-warning{font-size:11.5px;color:#a05a1a;font-weight:600;}
.wish-btn{
  position:absolute;top:8px;right:8px;width:30px;height:30px;border-radius:50%;
  background:rgba(58,38,20,.55);border:1px solid var(--navy-line);
  display:flex;align-items:center;justify-content:center;
}
.wish-btn svg{width:15px;height:15px;stroke:var(--gold-light);}
.product-info{padding:13px 14px 15px;display:flex;flex-direction:column;gap:6px;flex:1;}
.product-cat{font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);}
.product-name{font-size:13.5px;font-weight:600;line-height:1.35;min-height:36px;}
.product-price-row{display:flex;align-items:baseline;gap:8px;margin-top:2px;}
.product-price{font-size:16.5px;font-weight:800;color:var(--brown-heading);}
.product-oldprice{font-size:12px;color:var(--muted);text-decoration:line-through;}
.add-btn{
  margin-top:8px;width:100%;padding:10px;border:1px solid var(--gold);border-radius:50px;
  background:transparent;color:var(--brown-heading);font-size:12.8px;font-weight:700;
  transition:.2s ease;display:flex;align-items:center;justify-content:center;gap:6px;
}
.add-btn svg{width:14px;height:14px;stroke:currentColor;}
.add-btn:hover{background:var(--gold);color:#1a1305;}
.add-btn.added{background:var(--ok);border-color:var(--ok);color:#0a1a08;}

.empty-state{text-align:center;padding:70px 20px;color:var(--muted);}
@keyframes spin{to{transform:rotate(360deg);}}
.empty-state svg{width:44px;height:44px;stroke:var(--gold-dim);margin:0 auto 14px;}

/* ---------------- policy modal ---------------- */
.modal-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:70;
  display:none;align-items:center;justify-content:center;padding:20px;
}
.modal-overlay.show{display:flex;}
.modal{
  background:var(--navy-mid);border:1px solid var(--navy-line);
  border-radius:var(--radius-lg);max-width:560px;width:100%;
  max-height:82vh;overflow-y:auto;padding:28px 26px;position:relative;
}
.modal-close{position:absolute;top:16px;right:16px;width:32px;height:32px;border-radius:50%;background:var(--navy-card);border:1px solid var(--navy-line);display:flex;align-items:center;justify-content:center;}
.modal-close svg{width:14px;height:14px;stroke:var(--cream);}
.modal h3{font-family:'Playfair Display',serif;color:var(--brown-heading);font-size:21px;margin-bottom:14px;padding-right:30px;}
.modal p, .modal li{font-size:13.3px;line-height:1.7;color:var(--ink);margin-bottom:10px;}
.modal ul{padding-left:18px;list-style:disc;}
.modal h4{font-size:13px;color:var(--brown-heading);margin:14px 0 6px;}

/* toast */
.toast{
  position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(20px);
  background:var(--navy-card);border:1px solid var(--gold);color:var(--cream);
  padding:13px 22px;border-radius:50px;font-size:13px;font-weight:600;
  z-index:80;opacity:0;pointer-events:none;transition:.3s ease;
  display:flex;align-items:center;gap:8px;box-shadow:0 12px 30px rgba(0,0,0,.4);
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
.toast svg{width:16px;height:16px;stroke:var(--ok);}

/* ---------------- footer ---------------- */
footer.site{background:var(--chrome-bg);border-top:1px solid var(--chrome-line);margin-top:40px;color:var(--chrome-text);}
.footer-grid{display:grid;grid-template-columns:1fr;gap:30px;padding:44px 20px;max-width:1280px;margin:0 auto;}
.footer-col h4{font-size:12.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--gold-light);margin-bottom:14px;}
.footer-col button.link, .footer-col a{
  display:block;background:none;border:none;text-align:left;
  color:var(--chrome-muted);font-size:13px;padding:6px 0;transition:.2s ease;
}
.footer-col button.link:hover, .footer-col a:hover{color:var(--gold-light);}
.footer-brand p{color:var(--chrome-muted);font-size:12.8px;line-height:1.7;margin-top:10px;max-width:36ch;}
.footer-bottom{
  border-top:1px solid var(--chrome-line);padding:18px 20px;
  text-align:center;color:var(--chrome-muted);font-size:11.5px;
}

/* admin panel */
.admin-warn{
  background:rgba(181,88,63,.1);border:1px solid var(--err);border-radius:10px;
  padding:11px 14px;font-size:12px;color:var(--ink);line-height:1.55;margin-bottom:16px;
}
.admin-login{display:flex;flex-direction:column;gap:12px;max-width:280px;}
.admin-list{max-height:44vh;overflow-y:auto;border:1px solid var(--navy-line);border-radius:12px;margin-bottom:16px;}
.admin-row{
  display:flex;flex-direction:column;align-items:stretch;gap:8px;padding:12px 14px;
  border-bottom:1px solid rgba(255,255,255,.05);font-size:12.5px;
}
.admin-row:last-child{border-bottom:none;}
.admin-row .aname{flex:1;min-width:140px;}
.admin-row .aname b{display:block;font-size:12.8px;font-weight:600;}
.admin-row .aname small{color:var(--muted);font-size:11px;}
.admin-fields{display:flex;gap:8px;flex-wrap:wrap;}
.admin-fields label{display:flex;flex-direction:column;gap:3px;font-size:9.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.03em;}
.admin-row input{
  width:72px;padding:7px 8px;background:var(--navy-card);border:1px solid var(--navy-line);
  border-radius:8px;color:var(--cream);font-family:inherit;font-size:12.5px;text-align:center;
}
.admin-row input:focus{outline:none;border-color:var(--gold);}
.admin-row.zero{background:rgba(224,128,111,.05);}
.admin-row-top{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;width:100%;margin-bottom:4px;}
.media-toggle{
  background:var(--navy-mid);border:1px solid var(--navy-line);color:var(--brown-heading);
  font-size:10.5px;padding:5px 10px;border-radius:50px;white-space:nowrap;flex-shrink:0;
}
.media-toggle:hover{border-color:var(--gold);}
.media-editor{display:none;flex-direction:column;gap:10px;width:100%;margin-top:10px;padding-top:10px;border-top:1px dashed var(--navy-line);}
.media-editor.open{display:flex;}
.media-field label{display:block;font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.03em;margin-bottom:4px;}
.media-input-row{display:flex;gap:8px;align-items:center;}
.admin-row .media-input-row input{
  flex:1;width:100%;padding:8px 10px;background:var(--navy-mid);border:1px solid var(--navy-line);
  border-radius:8px;color:var(--cream);font-family:inherit;font-size:11.5px;text-align:left;
}
.media-preview{width:34px;height:34px;border-radius:6px;object-fit:cover;flex-shrink:0;border:1px solid var(--navy-line);}
.admin-row .media-field input[id^="vid-"]{width:100%;}
.admin-actions{display:flex;gap:10px;flex-wrap:wrap;}
.code-box{
  background:#03070f;border:1px solid var(--navy-line);border-radius:10px;
  padding:12px 14px;font-family:monospace;font-size:11px;color:var(--brown-heading);
  max-height:180px;overflow:auto;white-space:pre-wrap;margin-top:12px;display:none;
}

@media (min-width:640px){
  .cat-grid{grid-template-columns:repeat(3,1fr);}
}
@media (min-width:900px){
  .hide-mobile{display:flex;}
  .hide-desktop{display:none;}
  .header-top{padding:0 32px;}
  .hero{padding:80px 20px 76px;}
  .hero h1{font-size:50px;}
  .cat-grid{grid-template-columns:repeat(4,1fr);}
  .footer-grid{grid-template-columns:1.4fr 1fr 1fr 1fr;}
}
@media (max-width:899px){
  .hide-desktop{display:flex;}
  .filters{
    position:fixed;top:0;bottom:0;left:0;width:86%;max-width:340px;z-index:61;
    border-radius:0;transform:translateX(-105%);transition:transform .3s ease;
    overflow-y:auto;
  }
  .filters.show{transform:translateX(0);}
  .filters-btn{display:flex;}
  .product-grid{grid-template-columns:repeat(2,1fr);}
}
@media (max-width:520px){
  .hero h1{font-size:30px;}
  .product-name{min-height:auto;}
}
</style>
