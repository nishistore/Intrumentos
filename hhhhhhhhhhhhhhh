/* ======================================================================
   RENDER: PRODUCT CARD
   ====================================================================== */
function productCard(p){
  const catObj = CATEGORIES.find(c=>c.key===p.cat);
  const subLabel = catObj ? (catObj.subs.find(s=>s.key===p.sub)||{}).label : '';
  const stock = p.stock || 0;
  const outOfStock = stock <= 0;
  const lowStock = stock > 0 && stock <= 3;
  const images = p.images || [];
  const hasVideo = !!p.video;
  return `
  <div class="product-card">
    <div class="product-photo" onclick="openProductDetail(${p.id})" style="cursor:pointer;">
      ${outOfStock ? `<span class="badge out">Agotado</span>` : (p.badge?`<span class="badge">${p.badge}</span>`:'')}
      ${(!outOfStock && p.old)?`<span class="badge discount" style="${p.badge?'top:38px;':''}">-${Math.round((1-p.price/p.old)*100)}%</span>`:''}
      <button class="wish-btn" aria-label="Favorito" onclick="event.stopPropagation();showToast('Guardado en favoritos')">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
      </button>
      ${images[0] ? `<img src="${images[0]}" alt="${p.name}" class="product-photo-img" loading="lazy" decoding="async">` : iconSvg(iconFor(p))}
      ${hasVideo ? `<span class="video-badge">▶ Video</span>` : ''}
    </div>
    <div class="product-info">
      <div class="product-cat">${subLabel}</div>
      <div class="product-name" onclick="openProductDetail(${p.id})" style="cursor:pointer;">${p.name}</div>
      <div class="product-price-row">
        <span class="product-price">${fmt(p.price)}</span>
        ${p.old?`<span class="product-oldprice">${fmt(p.old)}</span>`:''}
      </div>
      ${lowStock?`<div class="stock-warning">¡Solo quedan ${stock}!</div>`:''}
      ${outOfStock
        ? `<button class="add-btn" disabled style="opacity:.45;cursor:not-allowed;">Agotado</button>`
        : `<button class="add-btn" onclick="addToCart(${p.id}, this)">
             <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
             Agregar al carrito
           </button>`}
    </div>
  </div>`;
}

/* ======================================================================
