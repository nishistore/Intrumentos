{
  // El worker de la API de productos. Se despliega SOLO, desde esta carpeta:
  //   cd productos-api && npx wrangler deploy --keep-vars
  // ADMIN_SECRET es un secreto de Cloudflare (no va aqui) y sobrevive al deploy.
  "name": "chipao-productos-api",
  "main": "./worker.js",
  "compatibility_date": "2026-08-29",
  "d1_databases": [
    { "binding": "DB", "database_name": "chipao-productos", "database_id": "e5a36b0a-58ea-4461-a7bd-780ac5e6c000" }
  ]
}
