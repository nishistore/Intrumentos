/* ======================================================================
   FILTER ACTIONS
   ====================================================================== */
function accordionToggle(catKey){
  const el = document.querySelector(`.cat-accordion[data-cat="${catKey}"]`);
  el.classList.toggle('open');
}
function setCat(catKey, checked){
  state.activeCat = checked ? catKey : null;
  if(!checked) state.activeSubs = new Set();
  render();
}
function toggleSub(catKey, subKey, checked){
  state.activeCat = catKey;
  if(checked) state.activeSubs.add(subKey); else state.activeSubs.delete(subKey);
  render();
}
function setPriceMin(v){ state.priceMin = Math.max(0, Number(v)||0); render(); }
function setPriceMax(v){ state.priceMax = Math.min(PRICE_MAX, Number(v)||PRICE_MAX); render(); }
function setSort(v){ state.sort=v; render(); }
function clearFilters(){
  state.activeCat=null; state.activeSubs=new Set();
  state.priceMin=0; state.priceMax=PRICE_MAX; state.search='';
  render();
}
function toggleFiltersPanel(show){
  document.getElementById('filtersPanel')?.classList.toggle('show', show);
  document.getElementById('filtersOverlay')?.classList.toggle('show', show);
}

